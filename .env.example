# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/alphalens

# ========================================
# LLM Configuration
# ========================================
DEEPSEEK_API_KEY=your-deepseek-api-key      # primary LLM (DeepSeek V3, platform.deepseek.com)
CEREBRAS_API_KEY=your-cerebras-api-key      # optional: Cerebras Qwen-3-235B
OPENAI_API_KEY=sk-proj-your-openai-key      # fallback LLM + eval scoring (gpt-4.1-mini / gpt-4o)
LLM_PROVIDER=deepseek                       # deepseek | cerebras | openai | auto

# ========================================
# Data Sources (Web Search)
# ========================================
TAVILY_API_KEY=your-tavily-api-key          # optional web search capability

# ========================================
# Clerk Authentication
# ========================================
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
AUTH_DISABLED=true                          # true for local dev, false in production

# ========================================
# JWT
# ========================================
JWT_SECRET_KEY=your-jwt-secret-key

# ========================================
# Feature Flags
# ========================================
CACHE_DISABLED=false                        # set true during eval iterations, false in production

# ========================================
# Application Settings
# ========================================
ENVIRONMENT=development                     # development | production
PORT=8000
HOST=0.0.0.0
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ========================================
# Observability (LangSmith)
# ========================================
LANGCHAIN_TRACING_V2=true                   # enable/disable LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=alphalens

# ========================================
# CORS
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
